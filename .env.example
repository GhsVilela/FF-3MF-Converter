# Copy this file to .env and adjust as needed.
# The API token is optional. Set it when the app is exposed beyond your LAN.
AUTH_TOKEN=

# Maximum upload size in MB.
MAX_UPLOAD_MB=100

# Number of conversions processed in parallel. Keep at 1 on small NAS devices.
MAX_CONCURRENT_JOBS=1

# How long uploads and converted files are kept before cleanup.
JOB_TTL_MINUTES=60

LOG_LEVEL=info

# Set to true when the app is behind a trusted reverse proxy.
TRUST_PROXY=false
